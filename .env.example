# ─── Telegram ────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=

# ─── Google Sheets ───────────────────────────────────────────────────────────
# The long ID in your Sheet URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=

# Name of the sheet tab inside the spreadsheet (usually "Sheet1")
GOOGLE_SHEET_NAME=Sheet1

# ── Authentication (choose ONE method) ──────────────────────────────────────
# Method 1 (recommended for local dev — no key file needed):
#   Run: gcloud auth application-default login
#   Then leave GOOGLE_SERVICE_ACCOUNT_KEY_PATH blank.
#   googleapis will auto-detect your credentials.

# Method 2 (JSON key file — only if org policy allows key creation):
#   Download the key JSON from GCP Console → Service Accounts → Keys
#   Save it as service-account-key.json in the project root.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Method 3 (VM deploy — attach service account to the VM instance):
#   No key or ADC login needed; VM identity is used automatically.

# ─── Google Forms ────────────────────────────────────────────────────────────
# Public URL of the Registration Form (for reference — bot does not use it directly)
REGISTRATION_FORM_URL=

# Public URL of the Outdated-Info Report Form
REPORT_FORM_URL=

# ?entry.XXXXXXXXX IDs from the Report Form's pre-fill URL
# (Get them via the form's ⋮ menu → "Get pre-filled link")
REPORT_FORM_ENTRY_NAME=entry.
REPORT_FORM_ENTRY_BUSINESS=entry.

# ─── LLM API ─────────────────────────────────────────────────────────────────
# Groq (recommended free tier) — get key at console.groq.com
GROQ_API_KEY=

# Model to use on Groq (free-tier options: llama3-8b-8192, mixtral-8x7b-32768)
LLM_MODEL=llama3-8b-8192

# Google Gemini alternative (get key at aistudio.google.com)
# GEMINI_API_KEY=
